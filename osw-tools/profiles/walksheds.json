{
  "schemaVersion": 1,
  "name": "walksheds",
  "description": "The Walksheds cost function from before fan mode (cost-custom.py, as on TDEI ticket 1965). All footways are usable; crossings add 30 s and need curb ramps when avoiding curbs; steps are walked at 0.5 m/s unless avoiding curbs; streets cost more the higher the street avoidance and are closed at 1. Left out: indoor footways' opening hours, transit edges, closed edges, pathway stairs, sidewalk scoring and avoiding primary streets.",
  "parameters": {
    "uphill": {
      "type": "number",
      "default": 0.085,
      "min": 0,
      "max": 1,
      "description": "Maximum uphill grade, e.g. 0.085 for 8.5%",
      "label": "Maximum uphill steepness",
      "unit": "grade",
      "sliderMin": 0.04,
      "sliderMax": 0.15,
      "step": 0.005
    },
    "downhill": {
      "type": "number",
      "default": 0.1,
      "min": 0,
      "max": 1,
      "description": "Maximum downhill grade, as a positive number",
      "label": "Maximum downhill steepness",
      "unit": "grade",
      "sliderMin": 0.04,
      "sliderMax": 0.15,
      "step": 0.005
    },
    "avoid_curbs": {
      "type": "boolean",
      "default": false,
      "description": "Only use crossings with curb ramps at both ends, and no steps",
      "label": "Avoid raised curbs and stairs"
    },
    "street_avoidance": {
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "How strongly to avoid walking in streets: 0 not at all, 1 never",
      "label": "Street avoidance factor (1 = avoid streets, 0 = use streets)",
      "step": 0.1
    }
  },
  "layers": [
    {
      "name": "crossings",
      "match": {
        "highway": "footway",
        "footway": "crossing"
      },
      "delaySeconds": 30,
      "requireCurbRamps": "$avoid_curbs",
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      }
    },
    {
      "name": "sidewalks",
      "match": {
        "highway": "footway",
        "footway": "sidewalk"
      },
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      }
    },
    {
      "name": "footways",
      "match": {
        "highway": "footway"
      },
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      }
    },
    {
      "name": "steps",
      "description": "0.5 m/s at the default base speed of 1.3 m/s",
      "match": {
        "highway": "steps"
      },
      "speedFactor": 0.3846153846,
      "blocked": "$avoid_curbs"
    },
    {
      "name": "pedestrian_streets",
      "match": {
        "highway": [
          "pedestrian",
          "living_street"
        ]
      },
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      }
    },
    {
      "name": "cycleways",
      "match": {
        "highway": "cycleway",
        "foot": [
          "yes",
          "designated"
        ]
      },
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      }
    },
    {
      "name": "service_streets",
      "match": {
        "highway": "service"
      },
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      },
      "avoidance": {
        "amount": "$street_avoidance",
        "k": 2
      }
    },
    {
      "name": "residential_streets",
      "match": {
        "highway": "residential"
      },
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      },
      "avoidance": {
        "amount": "$street_avoidance",
        "k": 3
      }
    },
    {
      "name": "other_streets",
      "match": {
        "highway": [
          "secondary",
          "tertiary",
          "unclassified"
        ]
      },
      "inclineSpeed": {
        "maxUphill": "$uphill",
        "maxDownhill": "$downhill",
        "ideal": -0.0087,
        "divisor": 5,
        "minLengthForLimits": 3
      },
      "avoidance": {
        "amount": "$street_avoidance",
        "k": 4
      }
    }
  ],
  "otherEdges": "impassable"
}
